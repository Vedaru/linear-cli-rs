# The bridge as a user service.
#
#   install -Dm644 deploy/linear-bridge.service ~/.config/systemd/user/linear-bridge.service
#   systemctl --user daemon-reload && systemctl --user enable --now linear-bridge
#   loginctl enable-linger "$USER"     # so it survives a logout, and starts at boot
#
# No secret is in this file or in the config: the config names the environment variables
# (`token_env = "..."`) and the environment file below holds the values. Keep that file mode 600.
#
# For a system-wide service instead: move it to /etc/systemd/system, add `User=` and
# `StateDirectory=`, set the store to `/var/lib/linear-bridge/bridge.db`, and drop `ProtectHome`
# or keep the store out of the home directory.

[Unit]
Description=Linear <-> forge webhook bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# One config holds both halves: the CLI's settings and the bridge's sections.
ExecStart=%h/.local/bin/linear webhook serve --config %h/.config/linear/linear.toml
EnvironmentFile=%h/.config/linear-bridge/secrets.env
Restart=always
RestartSec=5

# A delivery is stored before it is worked on, so a restart loses nothing: whatever the service
# accepted is still in the queue and is picked up again. That is also why the portal dropping the
# network, or Linear retrying, is safe - intakes are idempotent by delivery id.
KillSignal=SIGTERM
TimeoutStopSec=20

# The service is read-only outside its own state: config and secrets it only reads, the store
# it writes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/linear-bridge

[Install]
WantedBy=default.target
